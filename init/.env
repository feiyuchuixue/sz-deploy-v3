# # Docker Compose 使用的网络名称
DOCKER_NETWORK_NAME=sz-network
# 部署脚本克隆目录
SCRIPT_DIR=sz-deploy
# 如果不设置参数不会使用账号和密码
GIT_USERNAME=
GIT_PASSWORD=
# 是否快速部署（跳过系统升级，但可能有兼容问题）
FAST_DEPLOY=true

# 根据系统选择包管理器（dnf/apt/yum）
PKG_MGR=dnf

# 仓库平台，可选 github/gitee/gitlab(需自行指定)/gitea（需自行指定）
GIT_REPO_PLATFORM=github
# 仓库分支
GIT_BRANCH=dev
# 各平台仓库地址
GIT_REPO_URL_GITHUB=github.com/feiyuchuixue/sz-deploy-v3.git
GIT_REPO_URL_GITEE=gitee.com/feiyuchuixue/sz-deploy-v3.git
GIT_REPO_URL_GITLAB=你的私有/公有gitlab仓库地址
GIT_REPO_URL_GITEA=你的私有/公有gitea仓库地址

# 数据库类型：mysql | postgresql（默认 mysql）
# 选择 postgresql 时，将跳过 MySQL 部署，改用 PostgreSQL
DB_TYPE=mysql

# 是否使用蓝绿部署（默认关闭，若开启可保证不停机更新）
USE_BLUE_GREEN_DEPLOY=false

# Spring Boot 激活环境
SPRING_PROFILES_ACTIVE=prod

# 镜像模式：registry 使用远程镜像仓库；local 仅用于 tools 本地调试脚本
IMAGE_MODE=registry
# registry 模式默认镜像仓库、命名空间和标签
IMAGE_REGISTRY=registry.cn-beijing.aliyuncs.com
IMAGE_NAMESPACE=sz-dev
IMAGE_TAG=latest
# admin 按数据库类型可使用不同 tag；MySQL 保持历史 latest 兼容，PostgreSQL 可由 CI 发布 latest-postgresql
ADMIN_MYSQL_IMAGE_TAG=latest
ADMIN_POSTGRESQL_IMAGE_TAG=latest-postgresql
# registry 模式默认拉取镜像；tools 本地调试脚本会显式改为 false
IMAGE_PULL=true
# 是否在升级脚本末尾清理悬空镜像
PRUNE_IMAGES=false

# 镜像显式覆盖项。留空时由 scripts/deploy-common.sh 按 IMAGE_MODE/IMAGE_TAG 统一生成。
SZ_SERVICE_ADMIN_IMAGE_MYSQL=
SZ_SERVICE_ADMIN_IMAGE_POSTGRESQL=
SZ_SERVICE_WEBSOCKET_IMAGE=
SZ_ADMIN_IMAGE=
NGINX_IMAGE=nginx:1.27.3

# LOCAL 资源持久化目录，sz-service-admin 读写，nginx-static 只读
RESOURCE_DATA_DIR=/home/data/sz-resource

# 数据库备份配置
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=90
MYSQL_BACKUP_ROOT=/home/data/mysql_backups
POSTGRES_BACKUP_ROOT=/home/data/postgres_backups

# MySQL 配置。DB_TYPE=mysql 时生效。
MYSQL_DATABASE=sz_admin_prod
MYSQL_CONTAINER=mysql8
MYSQL_USER=root
MYSQL_PASSWORD=Sz2025@123456

# PostgreSQL 配置。DB_TYPE=postgresql 时生效。
PG_MODE=internal
PG_PORT=127.0.0.1:5432
PG_CONTAINER_NAME=postgres18
PG_IMAGE=postgres:18.3
PG_SUPER_USER=postgres
PG_SUPER_PASSWORD=Yanfa2025@Sz
PG_DB_NAME=sz_admin_prod
PG_INTERNAL_USER=sz_admin_prod_user_in
PG_INTERNAL_PASSWORD=Yanfa2025@Sz123456
PG_EXTERNAL_USER=sz_admin_prod_user_out
PG_EXTERNAL_PASSWORD=Yanfa2025@Szo123456
PG_EXTERNAL_CIDR=
PG_INTERNAL_SUBNET=
# docker compose 下载地址 （ 当本地docker-compose-linux-x86_64文件不存在时可选用的远程下载地址）
# DOCKER_COMPOSE_URL=https://github.com/docker/compose/releases/download/v2.39.3/docker-compose-linux-x86_64
# Gitee 加速地址
DOCKER_COMPOSE_URL=https://gitee.com/feiyuchuixue/fork_docker_compose/releases/download/v2.39.3/docker-compose-linux-x86_64
