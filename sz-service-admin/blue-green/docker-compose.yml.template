services:
  ${NGINX_CONTAINER}:
    image: ${NGINX_IMAGE}
    container_name: ${NGINX_CONTAINER}
    restart: always
    ports:
      - "${SZ_SERVICE_ADMIN_PORT}:${NGINX_PORT}"
    volumes:
      - ${NGINX_CONF}:/etc/nginx/nginx.conf:ro
      - ${NGINX_UPSTREAMS}:/etc/nginx/upstreams
      - ${NGINX_CONF_D}:/etc/nginx/conf.d
      - ${RESOURCE_DATA_DIR}:/data:ro
    networks:
      ${DOCKER_NETWORK_NAME}:
        aliases:
          - sz-service-nginx
  ${GREEN_NAME}:
    image: ${SZ_SERVICE_ADMIN_IMAGE}
    container_name: ${GREEN_NAME}
    restart: always
    environment:
      - SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE}
      - DB_TYPE=${DB_TYPE}
    volumes:
      - ./logs:/logs
      - ./config:/config
      - ${RESOURCE_DATA_DIR}:/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:${HEALTH_PORT}${ACTUATOR_PATH} || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 15s
    networks:
      - ${DOCKER_NETWORK_NAME}

  ${BLUE_NAME}:
    image: ${SZ_SERVICE_ADMIN_IMAGE}
    container_name: ${BLUE_NAME}
    restart: always
    environment:
      - SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE}
      - DB_TYPE=${DB_TYPE}
    volumes:
      - ./logs:/logs
      - ./config:/config
      - ${RESOURCE_DATA_DIR}:/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:${HEALTH_PORT}${ACTUATOR_PATH} || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 15s
    networks:
      - ${DOCKER_NETWORK_NAME}

networks:
  ${DOCKER_NETWORK_NAME}:
    external: true
