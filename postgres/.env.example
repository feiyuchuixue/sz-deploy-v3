DOCKER_NETWORK_NAME=sz-network

# PostgreSQL mode: internal | external
PG_MODE=internal

# internal mode: 127.0.0.1:5432
# external mode: 5432
PG_PORT=127.0.0.1:5432

PG_CONTAINER_NAME=postgres16
PG_IMAGE=postgres:16

PG_DATA_DIR=/home/docker-compose/postgres/data
PG_CONFIG_DIR=/home/docker-compose/postgres/config
PG_LOG_DIR=/home/docker-compose/postgres/log

PG_SUPER_USER=postgres
PG_SUPER_PASSWORD=ChangeMe_Strong_Postgres_Password

PG_DB_NAME=sz_admin_preview

PG_INTERNAL_USER=sz_admin_preview_user_in
PG_INTERNAL_PASSWORD=ChangeMe_Strong_In_Password

PG_EXTERNAL_USER=sz_admin_preview_user_out
PG_EXTERNAL_PASSWORD=ChangeMe_Strong_Out_Password

# external mode only
PG_EXTERNAL_CIDR=203.0.113.10/32

# Optional: if empty, setup.sh auto detects docker network subnet
PG_INTERNAL_SUBNET=
